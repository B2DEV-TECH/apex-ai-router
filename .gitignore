# Environments / secrets
.env
*.env
!*.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node (apex-plugin build tooling, if any)
node_modules/
npm-debug.log*

# SQLite dev telemetry DB
*.db
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Benchmark run artifacts (results are committed explicitly, not scratch
# runs -- `make benchmark-mock`/`benchmark-real` write here by default)
benchmark/results/latest-mock/
benchmark/results/latest-real/
benchmark/results/_smoke/
benchmark/results/*.tmp.*

# Switchyard sidecar build output and generated (env-resolved) deploy config
.tools/
deploy/switchyard/routes.generated.toml
