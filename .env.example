# Copy this file to .env and fill in real values. Never commit .env.

# --- Gateway ---
APEX_AI_ROUTER_ENVIRONMENT=development
APEX_AI_ROUTER_LOG_LEVEL=info
APEX_AI_ROUTER_HOST=0.0.0.0
APEX_AI_ROUTER_PORT=8080

# Comma-separated inference API keys accepted from Oracle APEX / clients.
# (Not enforced yet — added ahead of time so this file documents the full
# shape of the configuration; see docs/security.md once auth is implemented.)
APEX_AI_ROUTER_API_KEYS=

# Admin API key, separate from inference keys. Never returned by any endpoint.
APEX_AI_ROUTER_ADMIN_API_KEY=

# Path to the non-secret routing policy file (virtual models -> targets).
APEX_AI_ROUTER_ROUTING_CONFIG=config/routing.yaml

# Reject request bodies larger than this many bytes (spec section 22).
APEX_AI_ROUTER_MAX_REQUEST_BODY_BYTES=1000000

# --- Model targets ---
# Logical target IDs referenced by routing.yaml. The router never hard-codes
# a specific vendor or model name; you decide what "efficient" and "capable"
# mean for your deployment.
EFFICIENT_MODEL_ID=
CAPABLE_MODEL_ID=
JUDGE_MODEL_ID=

# --- Provider credentials ---
# Referenced from routing.yaml by environment variable name
# (api_key_env: EFFICIENT_MODEL_API_KEY), never inlined into config files.
#
# Base URLs are host roots with NO path suffix (e.g. https://api.openai.com,
# not https://api.openai.com/v1) — apex-efficient/apex-capable append
# /v1/chat/completions themselves, and the switchyard-server TOML rendered
# from these targets (scripts/render_switchyard_config.py) appends its own
# /v1 for apex-auto. Adding /v1 here would double it up on one of the two.
EFFICIENT_MODEL_API_KEY=
EFFICIENT_MODEL_BASE_URL=
CAPABLE_MODEL_API_KEY=
CAPABLE_MODEL_BASE_URL=
JUDGE_MODEL_API_KEY=
JUDGE_MODEL_BASE_URL=

# --- Switchyard sidecar (apex-auto routing, Phase 3) ---
# Base URL of the running switchyard-server process. The gateway forwards
# apex-auto requests here; switchyard-server itself calls the efficient,
# capable, and judge targets above using deploy/switchyard/routes.generated.toml
# (rendered from this file by `scripts/render_switchyard_config.py`).
SWITCHYARD_BASE_URL=http://localhost:4000

# --- Local mock providers (docker-compose only) ---
MOCK_EFFICIENT_PORT=9001
MOCK_CAPABLE_PORT=9002
